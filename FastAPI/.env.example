# FastAPI/.env.example
# Salin file ini menjadi ".env" lalu isi sesuai environment kamu.
# JANGAN commit file ".env" asli ke Git (pastikan sudah ada di .gitignore).

# --- App Metadata ---
APP_NAME=Home Credit Default Risk API
APP_VERSION=1.0.0
ENVIRONMENT=local
# ENVIRONMENT valid values: local | production

# --- Server (dipakai saat testing lokal dengan uvicorn) ---
HOST=127.0.0.1
PORT=8000
DEBUG=True
# DEBUG=True -> tampilkan traceback error detail (jangan True di production)

# --- Path Model & Data (relatif terhadap root folder FastAPI/) ---
MODEL_PATH=app/ml/catboost_v3_pipeline.joblib
DEMO_LOOKUP_PATH=app/data/demo_lookup.csv.gz

# --- Threshold Keputusan (HASIL FREEZE dari 10_evaluation.ipynb, JANGAN diubah sembarangan) ---
DECISION_THRESHOLD=0.6669

# --- Logging ---
LOG_LEVEL=INFO
# LOG_LEVEL valid values: DEBUG | INFO | WARNING | ERROR

# --- CORS (kalau nanti frontend dipisah domain, misal saat di Vercel) ---
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000