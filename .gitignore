# ============================================
# DATASET MENTAH & HASIL OLAHAN (besar, regenerable dari script)
# ============================================
data/raw/*.csv
data/processed/*.csv

# Kecualikan: data dictionary kecil, berguna sebagai dokumentasi kolom
!data/raw/HomeCredit_columns_description.csv

# ============================================
# MODEL HASIL TRAINING (besar, regenerable dari notebooks/src/modeling)
# ============================================
models/
*.pkl
*.h5
*.joblib

# Kecualikan: model kecil (~860KB) yang dibutuhkan agar demo FastAPI bisa jalan
!FastAPI/app/ml/*.joblib
!FastAPI/app/ml/*.json

# ============================================
# LOG RUNTIME (selalu berubah, tidak ada nilai historis)
# ============================================
*.log
FastAPI/logs/

# ============================================
# PYTHON CACHE
# ============================================
__pycache__/
*.pyc
.ipynb_checkpoints/
notebooks/catboost_info/

# ============================================
# ENVIRONMENT & SECRETS
# ============================================
venv/
.env
FastAPI/.env

# ============================================
# EDITOR / OS
# ============================================
.vscode/
.DS_Store
